# Copy to backend/.env and fill in. One file for the whole backend -- gateway and engine both read it. Never commit the real file.

# --- PostgreSQL (system of record). The app creates and uses the schema "wfm"; it never touches other schemas.
# Use a role that can create schemas/tables. If it is a superuser or CREATEROLE role the app also creates a
# non-bypass role "wfm_app" and switches to it per request so row-level security is enforced.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DBNAME

# --- Redis / NATS / Engine
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222          # start nats-server with -js so JetStream (durable streams) is available
ENGINE_ADDR=127.0.0.1:50051
# Engine sizing (all optional; the defaults suit one machine).
#   ENGINE_GRPC_THREADS  threads answering calls. Default: four per core, between 32 and 128. A call waiting for the solver holds a thread but uses no CPU,
#                        so this is not what limits work; it is not grown under load, because more threads would only mean more solves fighting for memory.
#   ENGINE_MAX_RPCS      calls allowed in flight at once (default four per thread, 0 = no limit). Beyond it a call is refused at once with "engine busy" (503):
#                        the gateway tries another engine in ENGINE_ADDR or retries the job, instead of everything queueing and timing out together.
#   ENGINE_MAX_SOLVES    schedule solves running at once (default 2). Small ones share the cores; a very large one takes the whole gate.
#   ENGINE_SOLVER_THREADS  cores the solver may use in total (default: all of them).
# To handle more load, run another engine and list both: ENGINE_ADDR=127.0.0.1:50051,10.0.0.5:50051 (the gateway sends each call to the least busy one).

# --- HTTP
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
# The address people use in their browser (no trailing slash). Single sign-on registers "<PUBLIC_URL>/api/v1/auth/sso/callback" with your identity
# provider, and the SCIM address is "<PUBLIC_URL>/scim/v2". In production set it to your real https address, for example https://wfm.company.com.
# If empty, it is taken from the address each request arrived on.
PUBLIC_URL=http://localhost:3000
# Where people are sent after signing in with single sign-on (the web app). Defaults to the first CORS_ORIGIN.
APP_URL=http://localhost:3000
# The employee portal's address. Single sign-on from the portal returns people here. Must be a different value from APP_URL only when the portal is on its own address.
# Also set PUBLIC_URL when the portal is on a different host from the gateway: the sign-in must start and finish on the same address.
PORTAL_URL=http://localhost:3002
# Signing in without typing an organisation code. The sign-in link given to a new employee is PORTAL_URL/?org=CODE. For an address per organisation
# (acme.example.com) set a template instead, with {org} where the code goes; the portal must also be built with VITE_ORG_FROM_SUBDOMAIN=true.
# PORTAL_URL_TEMPLATE=https://{org}.example.com
# "Find my organisation" by work email on the sign-in screen tells whoever asks that an account exists. Rate limited; set false to switch it off.
LOGIN_DISCOVERY=true   # production: set false if the organisation code is given to people another way
# How often (seconds) the gateway checks for requests that waited too long for a supervisor and for departures whose last day has come. Default 300.
# APPROVAL_TICK_SECONDS=300
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=12h

# --- First-run bootstrap (only used when no tenant exists yet)
BOOTSTRAP_TENANT_NAME=My Organisation
BOOTSTRAP_TENANT_CODE=ORG
BOOTSTRAP_TIMEZONE=UTC
BOOTSTRAP_ADMIN_USER=admin
# Leave empty to have a random password generated and printed once on first start.
BOOTSTRAP_ADMIN_PASSWORD=
# The administrator, and anyone given a temporary password later, must choose their own at first sign-in.
# Set to false only for automated tests or a throwaway demo.
# FORCE_PASSWORD_CHANGE=false

# --- Platform Super Admin (optional: auto-provisions root super admin on startup)
PLATFORM_ADMIN_EMAIL=superadmin@wfm.local
PLATFORM_ADMIN_PASSWORD=Admin@123
# PLATFORM_JWT_SECRET=optional-independent-jwt-secret-for-platform-tokens

# Optional: only if the NATS server requires a login (Redis takes it inside REDIS_URL)
# Two separate deployments sharing one NATS server must not share consumers: give each its own prefix. Gateways of the SAME deployment leave it empty (they share the work).
# NATS_CONSUMER_PREFIX=
# NATS_USER=
# NATS_PASS=
# Production: keep this true (the default) and give NATS a certificate from a trusted CA. false only for a development server with a self-signed one.
# NATS_TLS_REJECT_UNAUTHORIZED=true

# Key that encrypts stored secrets (mail and SMS credentials, webhook signing secrets, the single sign-on client secret, connector credentials).
# Generate one with:  openssl rand -hex 32     Keep it out of the database and out of backups of the database.
# If this is empty a key is derived from JWT_SECRET, which works but ties the two together: change JWT_SECRET and saved secrets become unreadable.
# To rotate: move the old value to SECRETS_KEY_PREVIOUS (comma separated), put the new one here, restart. Everything is re-encrypted at start-up.
SECRETS_KEY=
# SECRETS_KEY_PREVIOUS=

# --- Running several gateways (see docs/PERFORMANCE.md) ---
# all = one process does everything (default); web = requests only (run many); jobs = also the timers and workers (run exactly one)
# GATEWAY_ROLE=all
# Database connections held by this process. (processes) x this must stay under the database's max_connections.
# DB_POOL_MAX=12

# --- Capacity (see docs/PERFORMANCE.md). All of these are worked out automatically when left unset. ---
# DB_POOL_MAX=            # connections per process; default: from the database's max_connections and GATEWAY_MAX_REPLICAS
# GATEWAY_MAX_REPLICAS=4  # the most web gateway processes that may run at once
# SCHEDULE_PART_PARALLEL= # parts of one build sent to the engines at once; default: 2 per engine + 1
# ENGINE_DISCOVER=        # name:port that resolves to every engine (autoscaled engines); use instead of ENGINE_ADDR
# ENGINE_QUEUE_WAIT_SEC=30          # how long a quick calculation waits for a full engine
# ENGINE_BUILD_QUEUE_WAIT_SEC=300   # how long a schedule build waits
# METRICS_TOKEN=          # require Authorization: Bearer <token> at /metrics (default: private networks only)
# ENGINE_MAX_SOLVES=      # engine: solves at once; default from cores and memory
# ENGINE_METRICS_PORT=9109  # engine: metrics port (0 = off)
# ENGINE_DRAIN_SEC=100    # engine: how long to finish work under way after SIGTERM

# --- Outbound connections (see docs/PERFORMANCE.md and src/netGuard.ts) ---
# Data-feed connectors, webhooks, SMS gateways and the single sign-on provider make this server connect to an address an administrator typed in. By default it refuses
# loopback, link-local, private networks and cloud metadata addresses, so a configuration administrator cannot aim it at the platform's own database, cache or network.
# To reach something private on purpose (a customer's database over a VPN), name it here: IP addresses, CIDR ranges and host names, separated by commas.
# OUTBOUND_ALLOW=10.20.0.0/16,reports-db.corp.example
# OUTBOUND_ALLOW_PRIVATE=true      # allow every private network (10/8, 172.16/12, 192.168/16, fc00::/7) but still not loopback; for a deployment that lives inside one
# Development only (local mock servers): OUTBOUND_ALLOW=127.0.0.0/8,::1

