{
  "name": "wfm-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WFM API gateway: REST + WebSocket, JWT/RBAC, tenant isolation, audit, orchestration of the Python engine over gRPC.",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "start": "tsx --env-file=../.env src/index.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "test:password": "tsx --test test/forced/passwordChange.test.ts",
    "create-superadmin": "tsx --env-file=../.env scripts/create-superadmin.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "@types/pdfkit": "^0.17.7",
    "bcryptjs": "^3.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.0.0",
    "jsonwebtoken": "^9.0.0",
    "nats": "^2.29.0",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.0.0",
    "ssh2-sftp-client": "^12.1.1",
    "ws": "^8.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.11.0",
    "@types/ssh2": "^1.15.6",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/ws": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
