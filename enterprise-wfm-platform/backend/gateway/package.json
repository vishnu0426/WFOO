{
  "name": "wfm-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WFM API gateway: REST + WebSocket, JWT/RBAC, tenant isolation, audit, orchestration of the Python engine over gRPC.",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "start": "tsx --env-file=../.env src/index.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "bcryptjs": "^3.0.0",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.0.0",
    "jsonwebtoken": "^9.0.0",
    "nats": "^2.29.0",
    "pg": "^8.0.0",
    "ws": "^8.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
