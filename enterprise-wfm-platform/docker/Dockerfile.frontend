# Frontend image: builds the admin web app and the employee portal, serves both with nginx.
#   admin web app   -> port 3000
#   employee portal -> port 3001
# nginx forwards /api, /health and /ws to the gateway on 127.0.0.1:4000 (the compose file uses host networking).
# Build context is the repository root (enterprise-wfm-platform/).

FROM node:22-slim AS build-admin
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.ts tsconfig.json ./
COPY src ./src
# Optional AG Grid Enterprise licence; without it the grids show a trial watermark.
ARG VITE_AG_GRID_LICENSE=""
ENV VITE_AG_GRID_LICENSE=$VITE_AG_GRID_LICENSE
RUN npm run build

FROM node:22-slim AS build-portal
WORKDIR /app
COPY employee-portal/package.json employee-portal/package-lock.json ./
RUN npm ci
COPY employee-portal/index.html employee-portal/vite.config.ts employee-portal/tsconfig.json ./
COPY employee-portal/src ./src
RUN npm run build

FROM nginx:1.27-alpine AS frontend
RUN rm -f /etc/nginx/conf.d/default.conf
# proxy.inc is included by the server blocks; nginx only auto-loads *.conf files.
COPY docker/nginx.conf /etc/nginx/conf.d/wfm.conf
COPY docker/proxy.inc /etc/nginx/proxy.inc
COPY --from=build-admin  /app/dist /usr/share/nginx/admin
COPY --from=build-portal /app/dist /usr/share/nginx/portal
EXPOSE 3000 3001
